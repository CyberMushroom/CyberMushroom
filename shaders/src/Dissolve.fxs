// @name        Dissolve
// @category    Mask
// @target      ps_2_0
// @description Eats the image away in random blocks, with a burning edge. Works
// as a death effect on a sprite and as a scene transition on a layer, and
// because the blocks are square it stays honest on a pixel grid.
// @usage       Animate Amount from 0 to 1. Use Set effect parameter on Seed
// (any number) so two objects dissolving at once do not pick the same blocks.
// @param type=color var=_EdgeColor name="Edge Colour" default=16777215 desc="Colour of the band at the dissolve front."
// @param type=float var=_Amount    name="Amount"      default=0.0 min=0 max=1 desc="0 is untouched, 1 is completely gone. Animate this."
// @param type=float var=_Block     name="Block Size"  default=2.0 min=1 max=64 desc="Size of one dissolve block in texels. 1 is per-pixel static, larger reads as chunks falling away."
// @param type=float var=_Edge      name="Edge Width"  default=0.15 min=0 max=1 desc="How wide the coloured burning band is. 0 removes it."
// @param type=float var=_Seed      name="Seed"        default=0.0 min=0 max=1000 desc="Changes which blocks go first. Any two objects with different seeds dissolve differently."
// @param type=bool  var=_Invert    name="Reverse"     default=0 desc="On makes the object appear instead of disappear as Amount rises."

float4 fusion_main(in PS_INPUT In)
{
    float4 src = fusionTex(In, In.texCoord);

    float2 block = floor(In.texCoord / fusionTexel() / max(_Block, 1.0));
    float noise = fusionHash(block + _Seed);

    float amount = saturate(_Invert ? 1.0 - _Amount : _Amount);
    float edge = max(_Edge, 1.0e-4);

    /* Blocks vanish once the dissolve front passes their noise value; the
       band just ahead of the front is tinted on the way out. */
    float gone = step(noise, amount);
    float burning = saturate((amount + edge - noise) / edge) * (1.0 - gone);

    src.rgb = lerp(src.rgb, _EdgeColor.rgb, burning * step(0.001, _Edge));
    src.a *= 1.0 - gone;
    return src;
}

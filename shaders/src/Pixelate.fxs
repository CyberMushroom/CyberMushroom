// @name        Pixelate
// @category    Retro
// @target      ps_2_0
// @description Snaps the image to a coarser grid. Useful both as a permanent
// look and as a transition - ramp the block size up to dissolve a scene into
// squares.
// @usage       Animate Block Size from 1 upward for a "teleport out"; the
// object is untouched at 1, so you can leave the effect applied all the time.
// @note        Block size is measured in texels of the object's own image, so
// a scaled object gets scaled blocks.
// @param type=float var=_SizeX name="Block Width"  default=4.0 min=1 max=64 desc="Block width in texels. 1 leaves the image alone."
// @param type=float var=_SizeY name="Block Height" default=4.0 min=1 max=64 desc="Block height in texels. Set it to 1 with a wide block for a horizontal smear."
// @param type=bool  var=_Center name="Sample Centre" default=1 desc="On samples the middle of each block, which keeps thin features alive. Off samples the corner, which is the cheaper, blockier classic."

float4 fusion_main(in PS_INPUT In)
{
    float2 block = fusionTexel() * float2(max(_SizeX, 1.0), max(_SizeY, 1.0));
    float2 snapped = floor(In.texCoord / block) + (_Center ? 0.5 : 0.0);
    return fusionTex(In, snapped * block);
}

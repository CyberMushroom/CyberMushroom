// @name        Wipe
// @category    Mask
// @target      ps_2_0
// @description A straight-edged wipe at any angle, with an optional coloured
// leading edge. The workhorse scene transition - put it on a full-screen object
// and animate Amount.
// @usage       Amount 0 shows everything, 1 hides everything. Angle 0 wipes
// left to right, 90 wipes bottom to top.
// @param type=color var=_EdgeColor name="Edge Colour" default=16777215 desc="Colour of the band at the leading edge."
// @param type=float var=_Amount    name="Amount"   default=0.0 min=0 max=1 desc="How far the wipe has travelled. Animate this."
// @param type=float var=_Angle     name="Angle"    default=0.0 min=0 max=360 desc="Direction the wipe travels, in degrees."
// @param type=float var=_Softness  name="Softness" default=0.02 min=0 max=1 desc="How gradual the edge is. 0 is a hard line."
// @param type=float var=_Edge      name="Edge Width" default=0.0 min=0 max=1 desc="Width of the coloured leading band. 0 removes it."
// @param type=bool  var=_Invert    name="Reverse"  default=0 desc="On wipes the object in instead of out."

float4 fusion_main(in PS_INPUT In)
{
    float4 src = fusionTex(In, In.texCoord);

    float2 dir = fusionRotate(float2(1.0, 0.0), radians(_Angle));
    dir.y = -dir.y;
    /* Project onto the wipe direction and rescale so Amount 0..1 always
       crosses the whole object, whatever the angle. */
    float reach = abs(dir.x) + abs(dir.y);
    float along = (dot(In.texCoord - 0.5, dir) / reach) + 0.5;

    float amount = saturate(_Invert ? 1.0 - _Amount : _Amount);
    float soft = max(_Softness, 1.0e-4);
    float gone = 1.0 - smoothstep(amount - soft, amount + soft, along);

    float edge = max(_Edge, 1.0e-4);
    float band = saturate((amount + edge - along) / edge) * (1.0 - gone);

    src.rgb = lerp(src.rgb, _EdgeColor.rgb, band * step(0.001, _Edge));
    src.a *= 1.0 - gone;
    return src;
}

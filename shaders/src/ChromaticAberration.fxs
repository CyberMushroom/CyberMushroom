// @name        Chromatic Aberration
// @category    Screen
// @target      ps_2_0
// @description Splits the red and blue channels apart, the way a cheap lens or
// a composite cable does. A pinch of it sells "screen", a lot of it sells
// "something is wrong with the machine".
// @usage       Spike Strength to 3 or 4 for one frame on a hit, then ease it
// back to 0.5.
// @param type=float var=_Strength name="Strength"  default=1.0 min=0 max=32 desc="How far apart the channels are pulled, in texels."
// @param type=float var=_Angle    name="Angle"     default=0.0 min=0 max=360 desc="Direction of the split in degrees, used when Radial is off."
// @param type=bool  var=_Radial   name="Radial"    default=1 desc="On splits outward from the centre so the edges of the screen suffer most, which is how a lens behaves. Off splits everything the same direction."
// @param type=float var=_Falloff  name="Centre Falloff" default=1.0 min=0 max=4 desc="Radial only: how quickly the split fades out toward the middle of the image."

float4 fusion_main(in PS_INPUT In)
{
    float2 texel = fusionTexel();
    float2 centred = (In.texCoord - 0.5) * 2.0;

    float2 direction = fusionRotate(float2(1.0, 0.0), radians(_Angle));
    direction.y = -direction.y;
    float2 radial = centred * pow(saturate(length(centred)), max(_Falloff, 0.0));
    float2 offset = (_Radial ? radial : direction) * _Strength * texel;

    float4 src = fusionTex(In, In.texCoord);
    float r = fusionTex(In, In.texCoord + offset).r;
    float b = fusionTex(In, In.texCoord - offset).b;

    return float4(r, src.g, b, src.a);
}

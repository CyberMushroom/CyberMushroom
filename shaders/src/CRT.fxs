// @name        CRT
// @category    Screen
// @target      ps_3_0
// @description A whole tube in one pass: barrel curvature, scanlines, a shadow
// mask and a vignette, with the area outside the glass blacked out. Everything
// can be dialled to zero, so you can keep just the parts you want.
// @usage       Apply to a layer or to the frame, never to individual sprites -
// the curvature has to bend the finished picture.
// @note        Curvature reads the image outside its own edges, which do not
// exist, so the corners are filled with Bezel Colour rather than smeared
// pixels.
// @param type=color var=_Bezel     name="Bezel Colour"  default=0 desc="What shows outside the curved glass."
// @param type=float var=_Curve     name="Curvature"     default=0.15 min=0 max=1 desc="How much the picture bows outward. 0 is a flat panel."
// @param type=float var=_Scanlines name="Scanlines"     default=0.3 min=0 max=1 desc="Strength of the horizontal scanlines."
// @param type=float var=_Period    name="Line Spacing"  default=2.0 min=1 max=16 desc="Texels from one scanline to the next."
// @param type=float var=_Mask      name="Shadow Mask"   default=0.2 min=0 max=1 desc="Strength of the RGB stripe mask. Only visible if the image is drawn at 3 or more screen pixels per texel."
// @param type=float var=_Vignette  name="Vignette"      default=0.3 min=0 max=1 desc="Darkening toward the corners."
// @param type=float var=_Brightness name="Brightness"   default=1.15 min=0 max=3 desc="Lifts the picture back up - scanlines and mask both cost light."

float4 fusion_main(in PS_INPUT In)
{
    /* Bow the sampling grid outward from the centre of the screen. */
    float2 centred = In.texCoord - 0.5;
    float2 uv = In.texCoord + centred * dot(centred, centred) * _Curve;

    float2 outside = step(uv, float2(0.0, 0.0)) + step(float2(1.0, 1.0), uv);
    float offGlass = saturate(outside.x + outside.y);

    float4 src = fusionTex(In, saturate(uv));

    float2 pixel = uv / fusionTexel();

    float phase = frac(pixel.y / max(_Period, 1.0));
    float scan = abs(phase - 0.5) * 2.0;
    src.rgb *= 1.0 - (1.0 - scan) * saturate(_Scanlines);

    /* Three-phase stripe mask: each screen column leans toward one primary. */
    float stripe = frac(pixel.x / 3.0);
    float3 mask = float3(step(stripe, 0.334),
                         step(0.334, stripe) * step(stripe, 0.667),
                         step(0.667, stripe));
    src.rgb *= lerp(float3(1.0, 1.0, 1.0), 0.4 + mask * 1.2, saturate(_Mask));

    float2 vig = centred * 2.0;
    src.rgb *= 1.0 - saturate(dot(vig, vig) * 0.5) * saturate(_Vignette);

    src.rgb = saturate(src.rgb * _Brightness);
    src.rgb = lerp(src.rgb, _Bezel.rgb, offGlass);
    src.a = lerp(src.a, 1.0, offGlass);
    return src;
}

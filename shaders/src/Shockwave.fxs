// @name        Shockwave
// @category    Distort
// @target      ps_2_0
// @description An expanding ring that bends whatever it passes over. The
// explosion effect: pair it with a white flash and a screen shake and a small
// hit turns into an event.
// @usage       Apply to a layer. On the explosion, set Radius to 0 and add
// about 0.04 to it every tick until it passes 1.5, easing Strength down to 0 as
// it goes.
// @param type=float var=_CenterX  name="Centre X"  default=0.5 min=0 max=1 desc="Centre of the ring across the object, 0 is the left edge and 1 the right."
// @param type=float var=_CenterY  name="Centre Y"  default=0.5 min=0 max=1 desc="Centre of the ring down the object."
// @param type=float var=_Radius   name="Radius"    default=0.3 min=0 max=2 desc="Current size of the ring, where 1 is half the object's width. Animate this."
// @param type=float var=_Width    name="Ring Width" default=0.1 min=0.01 max=1 desc="How thick the disturbed band is."
// @param type=float var=_Strength name="Strength"  default=8.0 min=-64 max=64 desc="How far the ring pushes pixels, in texels. Negative pulls inward."
// @param type=float var=_Highlight name="Highlight" default=0.2 min=0 max=2 desc="Brightens the crest of the ring so it reads even against flat colour."

float4 fusion_main(in PS_INPUT In)
{
    float2 texel = fusionTexel();
    float aspect = fPixelHeight / max(fPixelWidth, 1.0e-6);

    float2 centred = In.texCoord - float2(_CenterX, _CenterY);
    centred.x *= aspect;

    float dist = length(centred);
    float ring = 1.0 - saturate(abs(dist - _Radius) / max(_Width, 1.0e-4));
    ring *= ring;

    float2 direction = centred / max(dist, 1.0e-5);
    direction.x /= aspect;

    float2 uv = In.texCoord + direction * ring * _Strength * texel;
    float4 src = fusionTex(In, saturate(uv));

    src.rgb = saturate(src.rgb + ring * _Highlight * src.a);
    return src;
}

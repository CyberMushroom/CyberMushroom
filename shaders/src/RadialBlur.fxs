// @name        Radial Blur
// @category    Blur
// @target      ps_3_0
// @description Blurs outward from a point, or around it. Zoom for a dash or a
// hit, spin for a dizzy spell or a spinning pickup.
// @usage       Spike Zoom to 0.2 for three frames when the player dashes, then
// ease it back to 0.
// @sampler     0 linear clamp clamp
// @param type=float var=_CenterX name="Centre X" default=0.5 min=-1 max=2 desc="Point the blur radiates from, across the object."
// @param type=float var=_CenterY name="Centre Y" default=0.5 min=-1 max=2 desc="Point the blur radiates from, down the object."
// @param type=float var=_Zoom    name="Zoom"     default=0.1 min=-1 max=1 desc="Smear toward or away from the centre. Negative pulls inward."
// @param type=float var=_Spin    name="Spin"     default=0.0 min=-1 max=1 desc="Smear around the centre instead. Positive and negative spin opposite ways."
// @param type=float var=_Hole    name="Clear Centre" default=0.0 min=0 max=1 desc="Keeps the middle sharp out to this radius, so a character at the centre of a dash stays readable."
// @param type=float var=_Amount  name="Amount"   default=1.0 min=0 max=1 desc="Blends the blurred result back over the sharp original."

float4 fusion_main(in PS_INPUT In)
{
    float4 src = fusionTex(In, In.texCoord);
    float2 center = float2(_CenterX, _CenterY);

    float2 offset = In.texCoord - center;
    float radius = length(offset);
    float strength = saturate((radius - _Hole) / max(1.0 - _Hole, 1.0e-4));

    float4 sum = float4(0.0, 0.0, 0.0, 0.0);
    float weight = 0.0;

    const int TAPS = 12;

    [unroll]
    for (int i = 0; i < TAPS; i++)
    {
        float t = (float)i / (float)(TAPS - 1) - 0.5;

        float2 scaled = offset * (1.0 + t * _Zoom * strength);
        float2 spun = fusionRotate(scaled, t * _Spin * strength);

        float4 tap = fusionTex(In, saturate(center + spun));
        float w = 1.0 - abs(t);

        sum += float4(tap.rgb * tap.a, tap.a) * w;
        weight += w;
    }

    sum /= weight;
    float4 blurred = float4(sum.rgb / max(sum.a, 1.0e-5), sum.a);

    return lerp(src, blurred, saturate(_Amount));
}
